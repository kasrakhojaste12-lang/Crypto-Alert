# ── Core service (runs OUTSIDE Iran) ───────────────────────────────
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto_alert
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-prod
CORE_PORT=4000
CORE_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Shared HMAC secret between core <-> payment bridge
BRIDGE_SHARED_SECRET=shared-bridge-secret-change-me
BRIDGE_BASE_URL=http://localhost:4100
BRIDGE_PORT=4100

# Binance market data (free, no API key needed) — market-data-only hosts.
# Bare /ws endpoint: the feed SUBSCRIBEs to per-symbol <symbol>@ticker streams for
# watched symbols. (The all-market !ticker@arr firehose opens but streams no data
# from some networks, so we don't use it.)
BINANCE_WS_URL=wss://data-stream.binance.vision/ws
BINANCE_REST_URL=https://data-api.binance.vision

# Feed mode: 'ws' = production (single all-tickers WebSocket). 'rest' = local
# fallback that polls 24h tickers for watched symbols, for when the Binance WS
# is filtered but REST is reachable (e.g. developing from Iran).
FEED_MODE=ws
REST_FEED_INTERVAL_MS=5000

# How often to re-sync the tradable-pair list so newly-listed Binance pairs
# become selectable automatically (default 1 hour).
SYMBOLS_REFRESH_MS=3600000

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBotUsername

# Email (SMTP) — provider must be reachable from the foreign core host
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Alert Key <no-reply@example.com>

# Subscription — priced in USDT, converted to Toman/Rial at the live Wallex rate.
SUB_PRICE_USDT=5
# Fallback USDT→Toman rate used only if Wallex is unreachable at boot.
USDT_TOMAN_FALLBACK=172000

# ── Payment bridge (runs INSIDE Iran) ──────────────────────────────
# Zibal sandbox merchant code is the literal "zibal"
ZIBAL_MERCHANT=zibal

# Cloudflare Turnstile captcha on login/signup. Leave both blank to disable
# (captcha is skipped in dev). TURNSTILE_SECRET is server-side; the sitekey is
# public and baked into the web build.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Google Identity Services (same public OAuth Web application client ID in both).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Web (Next.js) — public, must be reachable by the browser ────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local dev only: POST /api/dev/tick to inject synthetic ticks when Binance is
# unreachable (e.g. developing from Iran). MUST be unset/0 in production.
DEV_TICK=0

# Launch campaign: new signups get free Premium until this date (ISO). After it
# passes, new signups get nothing; already-granted users keep access until then.
CAMPAIGN_END=2026-09-02T23:59:59.999Z
