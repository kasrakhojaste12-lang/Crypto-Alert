# Production env template. On the VPS, copy to `.env` and fill real values.
# NEVER commit the filled-in .env (it is gitignored).
# Note: env_file does NOT interpolate — write full literal values (e.g. the
# password appears both in POSTGRES_PASSWORD and inside DATABASE_URL; keep them equal).

# ---- Public address (one domain, path-based routing via Caddy) ----
DOMAIN=alerts.example.com
NEXT_PUBLIC_API_URL=https://alerts.example.com
WEB_BASE_URL=https://alerts.example.com
BRIDGE_BASE_URL=https://alerts.example.com/bridge

# ---- Internal service URLs (compose network) ----
CORE_BASE_URL=http://core:4000
CORE_PORT=4000
BRIDGE_PORT=4100

# ---- Postgres ----
POSTGRES_USER=alertkey
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
POSTGRES_DB=alert_key
DATABASE_URL=postgresql://alertkey:REPLACE_WITH_STRONG_SECRET@postgres:5432/alert_key

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Secrets (generate: openssl rand -hex 32) ----
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
BRIDGE_SHARED_SECRET=REPLACE_WITH_STRONG_SECRET

# ---- Binance feed (VPS is outside Iran -> use the live WebSocket) ----
BINANCE_WS_URL=wss://data-stream.binance.vision/ws/!ticker@arr
BINANCE_REST_URL=https://data-api.binance.vision
FEED_MODE=ws
REST_FEED_INTERVAL_MS=5000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_BOT_USERNAME=webiufbwiubot

# ---- Billing (Zibal sandbox merchant = "zibal"; amounts in Rial) ----
SUB_PRICE_RIAL=500000
ZIBAL_MERCHANT=zibal

# ---- Misc ----
NODE_ENV=production
# DEV_TICK must stay unset/0 in production.
